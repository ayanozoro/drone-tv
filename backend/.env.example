# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local MongoDB connection (used by default for local development)
MONGODB_URI=mongodb://127.0.0.1:27017/dronetv_db

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Optional: Admin Secret Key for administrative actions
ADMIN_API_KEY=dronetv_admin_secure_2026
